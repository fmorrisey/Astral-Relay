# Server
NODE_ENV=production
PORT=3031
HOST=0.0.0.0

# Database
DB_PATH=./data/relay.db

# Workspace
WORKSPACE_PATH=/workspace

# Security
SESSION_SECRET=change-me-to-a-random-64-char-string
SESSION_MAX_AGE=604800000

# Upload limits
MAX_UPLOAD_SIZE=10485760

# Optional: Git sync
#
# With this on, publishing commits content to GIT_BRANCH and pushes it. Point
# GIT_BRANCH at the branch your host builds the live site from -- publishing is
# then what makes a post live.
GIT_SYNC_ENABLED=false
GIT_BRANCH=main

# Optional: Webhook
WEBHOOK_URL=
WEBHOOK_TIMEOUT=5000

# Logging
LOG_LEVEL=info

# Rate limiting (defaults used by `src/middleware/rateLimit.js`)
# Format: window may include spaces; wrap in quotes if so.
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW="15 minutes"
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW="15 minutes"
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW="15 minutes"

# Docker: host path to your Astro site (mounted at /workspace in the container)
#
# Use a checkout dedicated to publishing, kept on GIT_BRANCH -- not a tree you
# also develop in. The CMS commits whatever branch that checkout has out, so a
# shared working copy means publishes land on whichever branch you last switched
# to.
HOST_WORKSPACE_PATH=/path/to/your/astro-site

# Docker: private key used to push content, mounted read-only into the
# container. A deploy key scoped to the site repository, not a personal key.
# Leave unset to disable pushing over SSH.
HOST_GIT_SSH_KEY_PATH=

# Docker: uid/gid owning the bind mounts. Must match, or git refuses the
# repository and written files end up owned by root.
HOST_UID=1000
HOST_GID=1000

# Set false ONLY behind a tailnet-bound reverse proxy serving plain HTTP;
# browsers drop a Secure cookie over http:// and login will not stick.
# Defaults to true when NODE_ENV=production.
COOKIE_SECURE=true

# Comma-separated list of allowed CORS origins, e.g.
# "http://localhost:3000,https://app.example.com".
# Unset: reflects any origin in development, same-origin only in production.
FRONTEND_ORIGINS=

# OpenAPI spec at /api/openapi.json and the browsable UI at /docs.
# Defaults to on outside production. This deployment is tailnet-only, so it opts in.
API_DOCS=true
